  "glossary": [
    {
      "term": "Generative KI",
      "definition": "KI-Systeme, die fähig sind, neue Inhalte wie Text, Bilder oder Code zu erstellen basierend auf Trainingsdaten."
    },
    {
      "term": "LLM",
      "definition": "Large Language Model - ein großes sprachliches Modell mit Millionen oder Milliarden von Parametern."
    },
    {
      "term": "Prompt Engineering",
      "definition": "Die Kunst, effektive Eingabeaufforderungen zu formulieren, um optimale Ergebnisse von LLMs zu erhalten."
    },
    {
      "term": "Token",
      "definition": "Kleinste Einheit der Textverarbeitung in LLMs, kann ein Wort, Wortteile oder sogar einzelne Zeichen darstellen."
    },
    {
      "term": "Halluzination",
      "definition": "Wenn ein LLM falsche oder erfundene Informationen als wahr präsentiert."
    }
  ]
}